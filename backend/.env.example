# Django 运行环境名称，例如 development、test、production。
DJANGO_ENV=development
# Django 签名和加密使用的密钥；本地和生产必须使用不同的随机值。
DJANGO_SECRET_KEY=replace-with-a-local-random-string
# 是否开启调试模式；生产环境必须为 false。
DJANGO_DEBUG=true
# 允许访问的主机列表，多个主机使用英文逗号分隔。
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# 允许跨域访问的前端地址，多个地址使用英文逗号分隔。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 允许执行 CSRF 请求的来源，多个地址使用英文逗号分隔。
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS 允许的 HTTP 方法，使用英文逗号分隔。
CORS_ALLOWED_METHODS=DELETE,GET,OPTIONS,PATCH,POST
# CORS 允许的请求头，使用英文逗号分隔；星号表示允许任意请求头。
CORS_ALLOW_HEADERS=*
# CORS 暴露给浏览器的响应头，使用英文逗号分隔。
CORS_EXPOSE_HEADERS=Mcp-Session-Id,X-Trace-ID
# 是否允许跨域请求携带凭证。
CORS_ALLOW_CREDENTIALS=true
# 反向代理传递原始协议时使用的请求头名称；生产必须与网关一致。
SECURE_PROXY_SSL_HEADER_NAME=HTTP_X_FORWARDED_PROTO
# 反向代理传递的 HTTPS 协议值。
SECURE_PROXY_SSL_HEADER_VALUE=https
# 是否强制把 HTTP 重定向到 HTTPS；生产必须为 true。
SECURE_SSL_REDIRECT=false
# 是否只通过 HTTPS 发送会话 Cookie；生产必须为 true。
SESSION_COOKIE_SECURE=false
# 是否只通过 HTTPS 发送 CSRF Cookie；生产必须为 true。
CSRF_COOKIE_SECURE=false
# HSTS 生效秒数；开发环境设为 0。
SECURE_HSTS_SECONDS=0
# HSTS 是否包含子域名。
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# HSTS 是否声明 preload。
SECURE_HSTS_PRELOAD=false
# Django 国际化语言代码。
LANGUAGE_CODE=zh-hans
# Django 时区名称。
TIME_ZONE=Asia/Shanghai
# 是否启用 Django 国际化。
USE_I18N=true
# 是否启用时区感知时间。
USE_TZ=true
# 静态资源 URL 前缀。
STATIC_URL=/static/
# 静态资源收集目录，相对路径以 backend 目录为基准。
STATIC_ROOT=staticfiles
# 媒体资源 URL 前缀。
MEDIA_URL=/media/
# 媒体资源存储目录，相对路径以 backend 目录为基准。
MEDIA_ROOT=media
# Django 默认主键字段类型。
DEFAULT_AUTO_FIELD=django.db.models.BigAutoField

# Docker Compose 使用的 MySQL root 密码；示例值仅用于本地占位。
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
# Docker Compose 使用的数据库时区。
MYSQL_TIME_ZONE=Asia/Shanghai
# Docker Compose 映射到宿主机的 MySQL 端口。
MYSQL_PUBLISHED_PORT=3306
# Docker Compose 映射到宿主机的 Redis 端口。
REDIS_PUBLISHED_PORT=6379
# MySQL 容器健康检查间隔，使用 Docker 时长格式，例如 10s。
MYSQL_HEALTHCHECK_INTERVAL=10s
# MySQL 容器健康检查超时时间，使用 Docker 时长格式。
MYSQL_HEALTHCHECK_TIMEOUT=5s
# MySQL 容器健康检查失败重试次数。
MYSQL_HEALTHCHECK_RETRIES=10
# Redis 容器健康检查间隔，使用 Docker 时长格式。
REDIS_HEALTHCHECK_INTERVAL=10s
# Redis 容器健康检查超时时间，使用 Docker 时长格式。
REDIS_HEALTHCHECK_TIMEOUT=5s
# Redis 容器健康检查失败重试次数。
REDIS_HEALTHCHECK_RETRIES=10

# MySQL 数据库名称。
MYSQL_DATABASE=dingchi_week_report
# MySQL 登录用户名。
MYSQL_USER=dingchi
# MySQL 登录密码；示例值仅用于占位。
MYSQL_PASSWORD=replace-me
# MySQL 数据库主机地址。
MYSQL_HOST=127.0.0.1
# MySQL 数据库端口。
MYSQL_PORT=3306
# MySQL 连接池/持久连接的复用时长，单位为秒。
MYSQL_CONN_MAX_AGE=60
# 是否在复用 MySQL 连接前执行健康检查。
MYSQL_CONN_HEALTH_CHECKS=true
# MySQL 连接池常驻连接数。
MYSQL_POOL_SIZE=10
# MySQL 连接池允许超出的临时连接数。
MYSQL_POOL_MAX_OVERFLOW=10
# MySQL 连接池获取连接超时时间，单位为秒。
MYSQL_POOL_TIMEOUT=30
# MySQL 连接池连接回收周期，单位为秒。
MYSQL_POOL_RECYCLE=900
# MySQL 连接池取出连接前是否执行健康检查。
MYSQL_POOL_PRE_PING=true
# MySQL 连接字符集。
MYSQL_CHARSET=utf8mb4
# MySQL 建立连接超时时间，单位为秒。
MYSQL_CONNECT_TIMEOUT=5
# MySQL 连接建立后执行的初始化 SQL。
MYSQL_INIT_COMMAND=SET sql_mode='STRICT_TRANS_TABLES'

# Redis 连接地址，格式为 redis://[:密码]@主机:端口/数据库编号。
REDIS_URL=redis://127.0.0.1:6379/0
# Docker Compose Redis 服务密码；外部 Redis 请按实际服务配置。
REDIS_PASSWORD=replace-me
# Redis 连接池允许的最大连接数。
REDIS_POOL_MAX_CONNECTIONS=50
# Redis 连接池健康检查间隔，单位为秒。
REDIS_POOL_HEALTH_CHECK_INTERVAL=30
# Redis 建立连接超时时间，单位为秒。
REDIS_SOCKET_CONNECT_TIMEOUT=3
# Redis 读写超时时间，单位为秒。
REDIS_SOCKET_TIMEOUT=3
# Redis 不可用时是否忽略异常并降级；关键链路应设置为 false。
REDIS_IGNORE_EXCEPTIONS=false

# OpenAI-compatible 服务访问密钥；请勿提交真实密钥。
AI_API_KEY=
# OpenAI-compatible 服务地址，留空时使用 SDK 默认地址。
AI_BASE_URL=
# 使用的大模型名称。
AI_MODEL=your-model-name
# AI 请求超时时间，单位为秒。
AI_TIMEOUT_SECONDS=60

# 雪花算法自定义纪元时间，Unix 毫秒时间戳；同一部署环境必须保持稳定。
SNOWFLAKE_EPOCH_MS=1704067200000
# 雪花算法工作节点编号，范围 0-31；不同进程/实例必须唯一。
SNOWFLAKE_WORKER_ID=1
# 雪花算法数据中心编号，范围 0-31；不同数据中心必须唯一。
SNOWFLAKE_DATACENTER_ID=1

# 登录令牌签名盐；必填，生产环境使用随机高熵值。
AUTH_TOKEN_SALT=replace-with-random-auth-token-salt
# 登录令牌有效期，单位为秒；必填，建议 28800。
AUTH_TOKEN_MAX_AGE_SECONDS=28800

# RSA 私钥文件路径；相对路径以 backend 目录为基准，生产必须由密钥管理系统挂载。
CRYPTO_PRIVATE_KEY_PATH=.keys/private_key.pem
# RSA 公钥文件路径；相对路径以 backend 目录为基准，可由接口安全发布。
CRYPTO_PUBLIC_KEY_PATH=.keys/public_key.pem
# RSA 私钥口令；本地无口令可留空，生产必须设置并通过安全配置注入。
CRYPTO_PRIVATE_KEY_PASSWORD=
# RSA 密钥生成位数；仅供 scripts/generate_crypto_keys.py 使用，建议至少 2048。
CRYPTO_KEY_SIZE=2048

# 日志级别；可选 DEBUG、INFO、WARNING、ERROR、CRITICAL。
LOG_LEVEL=INFO
# 日志目录；相对路径以 backend 目录为基准，目录不存在时启动时创建。
LOG_DIR=logs
# 当前日志文件名；必须是文件名，不要填写目录。
LOG_FILE_NAME=backend.log
# 滚动日志单文件最大字节数，超过后自动轮转。
LOG_MAX_BYTES=10485760
# 滚动日志保留的历史文件数量。
LOG_BACKUP_COUNT=5
# 是否同时输出控制台日志；可选 true 或 false。
LOG_CONSOLE_ENABLED=true
